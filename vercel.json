{
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/downloads/samenwerken-eenpager-nl.pdf",
      "destination": "/downloads/samenwerkingsvoorstel.pdf",
      "permanent": true
    },
    {
      "source": "/downloads/partnership-onepager-en.pdf",
      "destination": "/downloads/partnership-proposal.pdf",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/gidsen/",
      "destination": "/gratis/",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/free/",
      "permanent": true
    },
    {
      "source": "/nl/%23inside",
      "destination": "/nl/#inside",
      "permanent": false
    },
    {
      "source": "/nl/%23inside/",
      "destination": "/nl/#inside",
      "permanent": false
    },
    {
      "source": "/%23inside",
      "destination": "/#inside",
      "permanent": false
    },
    {
      "source": "/%23inside/",
      "destination": "/#inside",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
